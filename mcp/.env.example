# Base URL of the DevDigest API (default shown).
DEVDIGEST_API_URL=http://127.0.0.1:3001
# Set to 1 to also register the not-implemented get_blast_radius stub.
MCP_ENABLE_STUBS=0
# Per-request HTTP timeout in ms (the run wait itself is a fixed 120s).
DEVDIGEST_REQUEST_TIMEOUT_MS=15000
# error | warn | info | debug (stderr only)
MCP_LOG_LEVEL=info
